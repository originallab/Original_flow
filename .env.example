# Variables para levantar la base de datos local con Docker (compose.yml).
# Copia este archivo como .env y cambia los valores. NUNCA subas el .env real.
# El archivo se llama .env a proposito: asi `docker compose up` lo toma solo
# (ver docs/GUIDELINES.md, seccion "Docker local").

POSTGRES_USER=original_flow
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=original_flow
POSTGRES_PORT=5432
