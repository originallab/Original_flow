# Variables del frontend (Vite). Copia este archivo como .env si necesitas cambiar algo.
# Solo las que empiezan con VITE_ llegan al navegador: nunca pongas aqui secretos ni llaves reales.

# MODO DEMOSTRACION (solo desarrollo local; en una compilacion de produccion se ignora).
# En `true` la aplicacion responde sola, sin backend ni base de datos: sirve para navegar por las
# pantallas. Lo que hagas se guarda unicamente en este navegador. Pon `false` (o borra la linea)
# para trabajar contra el backend real.
VITE_DEMO_MODE=true

# Direccion base de la API. En desarrollo, /api/v1 pasa por el proxy de Vite hacia el backend (puerto 3000).
VITE_API_URL=/api/v1

# Acceso SIMULADO a Original Auth (solo desarrollo local; en una compilacion de produccion se ignora).
# Mientras no lleguen las credenciales reales, el login simula que Original Auth ya autentico a la persona.
# Estos valores deben coincidir con ORIGINALAUTH_TOKEN_APP y ORIGINALAUTH_SECRET_KEY de backend/.env
# (y el backend debe tener AUTH_MODE=mock_callback). Son valores inventados, nunca llaves reales.
VITE_AUTH_MODE=mock_callback
VITE_MOCK_TOKEN_APP=token-app-de-desarrollo
VITE_MOCK_SECRET_KEY=cambia-este-secreto-local

# Acceso REAL a Original Auth (el de produccion; cuando lleguen las credenciales).
# VITE_TOKEN_APP es el token_app de la aplicacion (es publico; el secret_key NUNCA va aqui: solo en backend/.env).
# VITE_ORIGINALAUTH_LOGIN_URL es la direccion de inicio de sesion que da Original Auth, con {session} donde espera
# la sesion que crea el backend y, si la pide, {token_app}. Ejemplo (INVENTADO, solo muestra la forma):
#   https://auth.ejemplo.com/login?app={token_app}&session={session}
# Debe ser https (o http hacia localhost para probar). Original Auth debe regresar a /auth/return (login correcto)
# o a /auth/error (login fallido) de este frontend, y llamar al callback del backend: POST /api/v1/auth/callback.
# VITE_TOKEN_APP=
# VITE_ORIGINALAUTH_CLIENT_ID es el cliente id que entrega Original Auth (publico). Solo se usa si la plantilla lleva {client_id}.
# VITE_ORIGINALAUTH_CLIENT_ID=
# VITE_ORIGINALAUTH_LOGIN_URL=
