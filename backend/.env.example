# Variables del backend. Copia este archivo como backend/.env y completa los valores.
# NUNCA subas el .env real ni pegues llaves reales en chats o documentos.
# Todas se leen en UN solo modulo: backend/src/config/ (nunca process.env suelto).

# --- Servidor ---
NODE_ENV=development
PORT=3000
# debug | info | warn | error | silent
LOG_LEVEL=info
# Origenes permitidos para CORS, separados por coma (lista explicita, sin *)
CORS_ORIGINS=http://localhost:5173
# Origenes desde los que se muestran las paginas publicadas (servicio de dominios de la empresa).
# Solo ellos pueden leer /api/v1/public/* desde un navegador. Vacio = ninguno. Nunca *.
PUBLIC_CORS_ORIGINS=

# --- Base de datos (debe coincidir con el .env de la raiz) ---
DATABASE_URL=postgresql://original_flow:cambia_esta_clave@localhost:5432/original_flow

# Cuántos proxies hay delante del servidor (0 = ninguno). Detrás de EasyPanel suele ser 1;
# sin esto, la IP que se guarda en auditoría y en el límite de peticiones sería la del proxy.
TRUST_PROXY_HOPS=0

# --- Sesiones ---
SESSION_PENDING_TTL_MINUTES=15
SESSION_TTL_DAYS=30
RATE_LIMIT_AUTH_SESSION_PER_MINUTE=30
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_LEADS_PER_MINUTE=10

# --- Original Auth ---
# Obligatorias. Mientras no lleguen las reales, en desarrollo usa valores inventados
# (AUTH_MODE=mock_callback). Las reales las entrega el encargado de Original Auth.
ORIGINALAUTH_TOKEN_APP=token-app-de-desarrollo
ORIGINALAUTH_SECRET_KEY=cambia-este-secreto-local
# mock_callback SOLO en desarrollo local; en cualquier otro entorno debe ser "real".
AUTH_MODE=mock_callback

# --- Media-as-a-Service ---
MEDIAAS_BASE_URL=
MEDIAAS_API_KEY=
MEDIAAS_SECRET_KEY=

# --- Original AI Engine ---
IAENGINE_BASE_URL=
IAENGINE_API_KEY=
IAENGINE_SECRET_KEY=

# --- Original Pay ---
# En desarrollo SIEMPRE el sandbox. La apikey de cada workspace NO va aqui: se guarda
# cifrada en Workspace.paymentConfig.
ORIGINALPAY_BASE_URL=https://api-test.origpay.com/
# Clave para cifrar/descifrar las apikeys de los workspaces (Fernet o equivalente).
PAYMENT_CONFIG_ENCRYPTION_KEY=
